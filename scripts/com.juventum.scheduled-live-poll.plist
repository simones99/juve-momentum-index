<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.juventum.scheduled-live-poll</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO_DIR__/scripts/scheduled_live_poll.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>150</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__REPO_DIR__/logs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO_DIR__/logs/launchd.log</string>
</dict>
</plist>
