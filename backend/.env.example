# Copy to .env for local (non-Docker) runs. In docker-compose these are
# injected via the `environment:` block instead.

# postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=postgresql+psycopg://juventum:juventum@localhost:5432/juventum

# https://www.football-data.org/client/register (free tier)
FOOTBALL_DATA_API_KEY=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
ENABLE_LLM_BRIEF=true
LLM_TIMEOUT_SECONDS=8.0

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
# Shared secret for POST /api/v1/admin/refresh and /api/v1/admin/poll-live
# (leave empty to disable both endpoints)
ADMIN_TOKEN=

# Used only by scripts/scheduled_live_poll.sh (not read by the FastAPI app
# itself) — where to POST /admin/poll-live. Point it at the deployed backend
# in production, or leave the http://localhost:8000 default for local dev.
BACKEND_URL=http://localhost:8000
