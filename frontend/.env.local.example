# Local dev (no Docker): point at the backend running on your host
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Note: this is baked in at build time. In production it must be set in
# Vercel's project settings to the public Render backend URL, and requires
# a redeploy if changed.

# Web push. Must match the backend's VAPID_PUBLIC_KEY (see backend/.env.example),
# generated together with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
